# Environment Variables
NODE_ENV=development
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harmony_learning_db
DB_USER=postgres
DB_PASSWORD=your-database-password

# App Configuration
# Secure admissions links fail closed unless this is the exact canonical production origin.
FRONTEND_URL=https://www.harmonylearning.co.za
BCRYPT_ROUNDS=12
# Keep false in production. Set true only for an intentional, temporary rollback.
STUDENT_PORTAL_ENABLED=false
# Default false. Enable only after the Parent self-activation production readiness audit.
PARENT_SELF_ACTIVATION_ENABLED=false
# Optional comma-separated existing Parent IDs for a controlled pilot.
# Leave empty/unset for full rollout when PARENT_SELF_ACTIVATION_ENABLED=true.
PARENT_SELF_ACTIVATION_PILOT_PARENT_IDS=

# Admissions email (Gmail API over HTTPS with OAuth 2.0)
GOOGLE_GMAIL_CLIENT_ID=your-google-oauth-client-id
GOOGLE_GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_USER=your-gmail-address
# Optional recipient for internal new-application notifications
ADMIN_NOTIFICATION_EMAIL=admissions-notification-address

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
