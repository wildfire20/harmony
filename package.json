{
  "name": "harmony-learning-institute",
  "version": "1.0.1",
  "description": "School Management System for Harmony Learning Institute",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "dev-full": "concurrently \"npm run dev\" \"npm run client\"",
    "build": "npm run install-client && npm run build-client",
    "build-client": "cd client && npm run build",
    "test:security": "node --test tests/security-phase1.test.js tests/student-portal-retirement.test.js",
    "test:fees": "cd client && CI=true npm test -- --watchAll=false --runTestsByPath src/data/fees2027.test.js",
    "test:admissions": "node --test tests/admissions-management.test.js tests/enrollment-status-width-fix.test.js",
    "test:email": "node --test tests/admissions-email.test.js",
    "verify:email": "node scripts/verify-email.js",
    "migrate:admissions": "node scripts/run-admissions-migration.js",
    "fix:enrollment-status-width": "node scripts/fix-enrollment-status-width.js",
    "install-client": "cd client && npm install",
    "heroku-postbuild": "npm run build",
    "railway-build": "npm run install-client && npm run build-client",
    "railway-setup": "node setup-database.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/lib-storage": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "googleapis": "^170.1.0",
    "helmet": "^7.0.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-fetch": "^3.3.2",
    "pdf.js-extract": "^0.2.1",
    "pg": "^8.11.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
